{
  "expo": {
    "name": "fateful-moment",
    "slug": "fateful-moment",
    "version": "1.0.0",
    "scheme": "fatefulmoment",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#020617",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "navigationBar": {
        "backgroundColor": "#020617",
        "barStyle": "light-content"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.hamzakar04.fatefulmoment"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-status-bar",
      [
        "expo-navigation-bar",
        {
          "hidden": false,
          "enforceContrast": false,
          "style": "dark"
        }
      ],
      "expo-video"
    ],
    "extra": {
      "router": {},
      "expo-navigation-bar": {
        "enforceContrast": false,
        "style": "dark",
        "hidden": false
      },
      "eas": {
        "projectId": "140cc595-2900-4d7f-8fec-2c2ca9ae8c43"
      }
    },
    "owner": "hamzakar04"
  }
}
